# Resend API Key for email collection
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Optional: Resend Audience ID (create an audience in Resend dashboard)
# Get this from: https://resend.com/audiences
RESEND_AUDIENCE_ID=your_audience_id_here

# Optional: Email to receive signup notifications (if no audience set up)
NOTIFICATION_EMAIL=your-email@example.com
